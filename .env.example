# Copia este archivo como ".env" y pega tu clave de Google AI Studio.
# NUNCA subas el archivo .env a GitHub ni lo muestres en capturas.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Enlace de tu Google Form (opcional, aparece como botón en la app)
FORM_URL= https://docs.google.com/forms/d/e/1FAIpQLScGXwWEAnbOvU_xi02aEaqIe-ffJNy2dMVdA4LwMSFmJeRCbQ/viewform?usp=publish-editor 
# Token para ver /registros en un despliegue público (invéntalo largo y secreto)
ADMIN_TOKEN=
# Ruta del archivo SQLite (opcional)
DB_PATH=registros.db
